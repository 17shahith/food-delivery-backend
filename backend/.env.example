# ---------------------------------------------------------------------------
# Supabase project credentials (Project Settings -> API / Database)
# NEVER commit real values. Copy this file to .env and fill it in locally.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret. Leave empty if your project only uses asymmetric
# (RS256/ES256) signing keys - they are verified through the JWKS endpoint.
SUPABASE_JWT_SECRET=

# Postgres connection string from Supabase (Session or Transaction pooler).
# postgresql:// URLs are converted to postgresql+asyncpg:// automatically.
DATABASE_URL=

SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# ENVIRONMENT=development
# DEBUG=false
# REALTIME_ENABLED=true
# GPS_MIN_DISTANCE_METERS=15
# GPS_MIN_INTERVAL_SECONDS=3
# GPS_HEARTBEAT_SECONDS=30
# ASSIGNMENT_OFFER_TTL_SECONDS=300
# DEFAULT_SEARCH_RADIUS_KM=5
# MAX_SEARCH_RADIUS_KM=50
